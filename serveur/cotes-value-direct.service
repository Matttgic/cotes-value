[Unit]
Description=Cotes Value en direct (collecte continue, alertes immédiates)
After=network-online.target
Wants=network-online.target

[Service]
User=cotes
WorkingDirectory=/opt/cotes-value
EnvironmentFile=/etc/cotes-value.env
ExecStart=/opt/cotes-value/.venv/bin/python scripts/serveur_direct.py
# Relancé après une erreur, et après une mise à jour du code (le programme s'arrête de lui-même).
Restart=always
RestartSec=30
# Le temps d'enregistrer les données et de rendre la main à GitHub à l'arrêt.
TimeoutStopSec=300
Nice=5
# Durcissement (audit du 26/11/2026) : le programme n'écrit que dans /opt/cotes-value (code, données, mémoire)
# et dans son /tmp privé ; /usr, /boot et /etc restent en lecture seule, aucun gain de privilège possible.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
