# Configuration du serveur en direct (/etc/cotes-value.env, lisible par root seulement). Même rôle que les secrets
# et variables de GitHub Actions : recopier les mêmes valeurs. Ne jamais versionner ce fichier rempli.

# --- Obligatoire ---------------------------------------------------------------------------------------------
# Jeton GitHub « fine-grained », dépôt Matttgic/cotes-value seulement : Contents et Actions en lecture et écriture.
GITHUB_TOKEN=

# --- Alertes (comme les secrets GitHub du même nom) ------------------------------------------------------------
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
# Vide : les stratégies cochées sur le site.
PUSHOVER_STRATEGIES=
PUSHOVER_PRIORITY=0
# Mise Kelly ¼ ramenée à ta bankroll, en euros (ligne STAKE|MIN|URL pour MacroDroid).
PUSHOVER_BANKROLL=1000
PUSHOVER_LIGNE_MACRO=oui
ALERTE_WEBHOOK_URL=
ALERTE_WEBHOOK_KEY=
ALERTE_WEBHOOK_CLE_ENTETE=x-api-key

# --- Pinnacle et ses secours ------------------------------------------------------------------------------------
PINNACLE_API_KEY=
PINNACLE_RECHAUFFEUR_URL=
PINNACLE_RECHAUFFEUR_SECRET=
PINNACLE_AGE_MAX_MIN=10
PINNACLE_AGE_MAX_LOIN_MIN=16
PINNODDS_API_KEY=
PINNODDS_LIMITE_JOUR=90
PINNODDS_PAUSE_MIN=30
PINNODDS_HANDICAPS=non
PINNACLE_SECOURS_PERIME=football
PINBOOK_API_KEY=
PINBOOK_LIMITE_JOUR=16
PINBOOK_PAUSE_MIN=60
PINBOOK_SPORTS=football,tennis,basket

# --- Autres sources et règlement ---------------------------------------------------------------------------------
MODE_COLLECTE=complet
SMARKETS_COLLECTE=oui
SOURCE_MATCHBOOK=direct
PROPLINE_API_KEY=
THE_ODDS_API_KEY_2=
THE_ODDS_API_KEY_3=
THE_ODDS_API_KEY_4=

# --- Rythme du serveur ------------------------------------------------------------------------------------------
# Au plus un cycle par PERIODE_S secondes ; enregistrement, règlement et site toutes les PUBLICATION_S secondes.
PERIODE_S=60
PUBLICATION_S=300
