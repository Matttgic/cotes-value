# Configuration locale : exporter ces variables dans le shell avant exécution.
# Le programme ne charge pas automatiquement ce fichier et ne dépend pas de python-dotenv.
# Clé guest : app.json (api.haywire.apiKey), puis cette variable, puis la valeur historique du code.
PINNACLE_API_KEY=
# Âge maximum du cache Cloudflare des cotes Pinnacle (en-tête HTTP Age), en minutes.
# Au-delà, la cote est marquée périmée et ne déclenche pas de pari. Défaut : 10.
# Sans en-tête Age et sans réchauffeur, la cote est aussi périmée.
PINNACLE_AGE_MAX_MIN=10
# Fonction Supabase pinnacle-rechauffe (Paris). Les deux vides : pas d'appel.
PINNACLE_RECHAUFFEUR_URL=
PINNACLE_RECHAUFFEUR_SECRET=
# Secours facultatif : remplace l'hôte https://guest.api.arcadia.pinnacle.com/0.1
PINNACLE_PROXY_URL=
# Ces clés de compte ne doivent jamais être remplies dans un fichier versionné.
# Secours Pinnacle (pinnodds.com, clé gratuite : 100 requêtes par jour). Vide : pas de secours.
PINNODDS_API_KEY=
PINNODDS_LIMITE_JOUR=90
PINNODDS_PAUSE_MIN=30
THE_ODDS_API_KEY_1=
THE_ODDS_API_KEY_2=
THE_ODDS_API_KEY_3=
THE_ODDS_API_KEY_4=
PROPLINE_API_KEY=
# Winamax, Betclic, Unibet et PMU sont toujours lus en direct. OlyBet et NetBet : direct (défaut) ou off.
SOURCE_OLYBET=direct
SOURCE_NETBET=direct
# Smarkets a toujours sa table de paris (10 €), comme Polymarket.
# oui l'ajoute aussi au consensus partagé. Défaut non : hors de cette moyenne.
SMARKETS_DANS_DECISION=non
# Variables serveur Supabase : configurées dans Supabase, jamais dans web/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Aucune clé anon nécessaire : le navigateur appelle la fonction de notifications.
