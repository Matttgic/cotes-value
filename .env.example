# Configuration locale : exporter ces variables dans le shell avant exécution.
# Le programme ne charge pas automatiquement ce fichier et ne dépend pas de python-dotenv.
# Clé guest : app.json (api.haywire.apiKey), puis cette variable, puis la valeur historique du code.
PINNACLE_API_KEY=
# Âge maximum du cache Cloudflare des cotes Pinnacle (en-tête HTTP Age), en minutes.
# Au-delà, la cote est marquée périmée et ne déclenche pas de pari. Défaut : 10.
PINNACLE_AGE_MAX_MIN=10
# Ces clés de compte ne doivent jamais être remplies dans un fichier versionné.
PULSESCORE_KEY=
THE_ODDS_API_KEY_1=
THE_ODDS_API_KEY_2=
THE_ODDS_API_KEY_3=
THE_ODDS_API_KEY_4=
PROPLINE_API_KEY=
# Espacement entre pages, selon l'offre PulseScore ; 1,1 s suppose PRO.
PULSESCORE_PAUSE=1.1
# Variables serveur Supabase : configurées dans Supabase, jamais dans web/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Aucune clé anon nécessaire : le navigateur appelle la fonction de notifications.
